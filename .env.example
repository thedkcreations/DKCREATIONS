# Copy these into Vercel → Project → Settings → Environment Variables.
# Do NOT commit a real .env file with actual values to GitHub.

# Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase → Project Settings → API
SUPABASE_URL=https://tiiyvmsguhetmzgiitya.supabase.co
# Project Settings → API → "service_role" key (NOT the anon key).
# This bypasses RLS, which is fine because it's only ever used
# server-side in api/verify-payment.js, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
